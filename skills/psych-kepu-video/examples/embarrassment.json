    {"t": "原因①：你太在意{g:别人的评价}。", "s": 3.4, "k": "c", "tag": "原因①", "scene": {"type": "crowd", "a": {"w": "me", "mood": "sad", "fx": "sweat"}, "n": 6, "eyes": true, "crowdMood": "angry"}},
    {"t": "有研究发现，越怕被{r:否定}的人越容易尴尬。", "s": 3.2, "k": "d", "tag": "原因①", "scene": {"type": "heart", "crack": true, "a": "me", "b": "friend"}},
    {"t": "尴尬，其实是在保护你的{g:自尊}。", "s": 2.8, "k": "e", "scene": {"type": "solo", "a": {"w": "me", "mood": "calm", "fx": "shine"}, "prop": "spot"}},
    {"t": "你是：{r:1} 当场尴尬，还是 {g:2} 回家才尴尬？", "s": 3.4, "k": "f", "scene": {"type": "choice", "a": {"label": "当场尴尬", "who": ["me", "friend"]}, "b": {"label": "回家才尴尬", "who": ["me"]}}}
  ]
}}
