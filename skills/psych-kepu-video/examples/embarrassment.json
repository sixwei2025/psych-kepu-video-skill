  "lines": [
    {"t": "一件小事，你能{g:尴尬}一整晚。", "s": 2.8, "k": "a", "scene": {"type": "solo", "a": {"w": "me", "mood": "sad", "fx": "loop", "say": "回放中…"}, "prop": "bed"}},
    {"t": "说错一句话，脑子反复{g:回放}。", "s": 3.0, "k": "a"},
